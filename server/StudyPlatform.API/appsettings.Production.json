{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // Non-secret production defaults only. Everything with a credential in it — the database
  // connection string, the JWT key, OAuth and SMTP secrets — is supplied by the environment
  // (ECS task environment variables / Secrets Manager), never by a file in the image.
  //
  // Required at runtime:
  //   ConnectionStrings__DefaultConnection = <managed Postgres connection string>
  //
  // See DEPLOYMENT.md for the full list.

  "Database": {
    // Applies pending EF Core migrations at startup. Set to false and run
    // `dotnet ef database update` as a one-off task once more than one replica starts at a time.
    "MigrateOnStartup": true,
    // Deliberately small: the API shares a managed Postgres instance's connection budget with
    // every other client, and Npgsql's own default of 100 per process would monopolise it.
    "MaxPoolSize": 20,
    "CommandTimeoutSeconds": 60,
    "ConnectTimeoutSeconds": 15
  },

  // Off. The distributed cache falls through to the Postgres CacheEntries tier and SignalR uses its
  // in-memory lifetime manager — no Redis server, no ElastiCache, no connection string needed.
  // Turn it on only alongside a real Redis (see DEPLOYMENT.md § "Enabling Redis later").
  "Redis": {
    "Enabled": false
  },

  "AllowedHosts": "*",

  // Operational, non-secret, and previously only present in the gitignored appsettings.json — which
  // the image no longer carries (see server/.dockerignore). Kept here so production behaviour is
  // identical without a developer's file being baked into the image.
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 100 },
      { "Endpoint": "POST:/api/auth/*", "Period": "1m", "Limit": 10 },
      { "Endpoint": "POST:/api/feedback", "Period": "1m", "Limit": 5 }
    ]
  },

  "Cache": {
    "DashboardStatsSeconds": 60,
    "AnalyticsSummarySeconds": 30,
    "GeneratedResultSeconds": 86400,
    "SasUrlSeconds": 3000
  },

  // 0 = unlimited. Pricing is per-million tokens, keyed by model-name prefix (longest match wins);
  // unpriced models still log tokens, at a $0 estimate.
  "AiUsage": {
    "DailyTokenLimit": 0,
    "Pricing": {
      "gpt-4o-mini": { "InputPerMillion": 0.15, "OutputPerMillion": 0.6, "CachedInputPerMillion": 0.075 },
      "gpt-4o": { "InputPerMillion": 2.5, "OutputPerMillion": 10.0, "CachedInputPerMillion": 1.25 },
      "claude-haiku": { "InputPerMillion": 1.0, "OutputPerMillion": 5.0, "CachedInputPerMillion": 0.1 },
      "claude-sonnet": { "InputPerMillion": 3.0, "OutputPerMillion": 15.0, "CachedInputPerMillion": 0.3 },
      "claude-opus": { "InputPerMillion": 5.0, "OutputPerMillion": 25.0, "CachedInputPerMillion": 0.5 },
      "deepseek-chat": { "InputPerMillion": 0.27, "OutputPerMillion": 1.1, "CachedInputPerMillion": 0.07 },
      "gemini-2.0-flash": { "InputPerMillion": 0.1, "OutputPerMillion": 0.4 },
      "qwen-plus": { "InputPerMillion": 0.4, "OutputPerMillion": 1.2 }
    }
  },

  // Semantic-search indexing. Embeddings__ApiKey is a credential and comes from the environment;
  // without it EmbeddingBackfillWorker is a no-op and search falls back to keyword results.
  "Embeddings": {
    "Provider": "gemini",
    "Model": "text-embedding-004",
    "BackfillIntervalMinutes": 1,
    "BackfillBatchSize": 5
  }
}
