<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StudyPlatform.API</RootNamespace>
    <UserSecretsId>studyplatform-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
    <!-- 10.0.9 is the first release whose MessagePack dependency (>= 2.5.301) is not vulnerable. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.5" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <!-- 0.11.1 moves to AngleSharp 1.5.2, which fixes an mXSS sanitizer bypass in the HTML parser
         this feeds every clipped web article through. -->
    <PackageReference Include="SmartReader" Version="0.11.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyPlatform.Application\StudyPlatform.Application.csproj" />
    <ProjectReference Include="..\StudyPlatform.Infrastructure\StudyPlatform.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Matches Application and Infrastructure: lets tests exercise internal helpers without
         widening the public surface. -->
    <InternalsVisibleTo Include="StudyPlatform.Tests" />
  </ItemGroup>

</Project>
