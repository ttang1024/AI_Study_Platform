# Semantic search (optional). With no ApiKey, embeddings are off, the backfill worker does not run,
# and search/RAG fall back to keyword retrieval — nothing breaks, it is just less good.
#
# Configured separately from the per-user chat provider on purpose: the backfill worker indexes
# outside any HTTP request, so it cannot read the per-request X-AI-* headers, and neither Anthropic
# nor DeepSeek publishes an embeddings API at all.
#
# The vector column is a fixed 1536 wide. Models with fewer dimensions are zero-padded (which
# preserves cosine similarity exactly); models with more are rejected.
Embeddings__Provider=openai            # "openai" (or any OpenAI-compatible /v1/embeddings) or "gemini"
Embeddings__Model=text-embedding-3-small
Embeddings__ApiKey=
# Embeddings__BaseUrl=                 # for OpenAI-compatible providers that aren't OpenAI (Qwen, a local server)
# Embeddings__BackfillIntervalMinutes=15
# Embeddings__BackfillBatchSize=25

# Per-user daily AI token budget. 0 (the default) means unlimited. Exceeding it returns HTTP 429
# with errorCode AI_QUOTA_EXCEEDED. Per-model prices live in appsettings.json under AiUsage:Pricing.
AiUsage__DailyTokenLimit=0
