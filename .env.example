# Database
POSTGRES_DB=studyplatform
POSTGRES_USER=studyplatform
POSTGRES_PASSWORD=your_secure_password

# JWT
JWT_SECRET_KEY=your_64_char_hex_secret_key
JWT_ISSUER=Study Platform
JWT_AUDIENCE=Study Platform Users
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Email (Gmail SMTP)
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=Study Platform
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Local object storage (MinIO, S3-compatible)
AWS_REGION=us-east-1
S3_BUCKET_NAME=documents-dev
S3_SERVICE_URL=http://minio:9000
S3_PUBLIC_SERVICE_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# AI / External APIs
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_SUBTITLE_LANGUAGES=en.*,en
# Optional. Use generate-cookies-env.sh for multiple deployed cookie sets.
YOUTUBE_COOKIES_B64=

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend origins for CORS
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:4200

# Build-time env for Vite frontends (leave empty to use nginx proxy)
VITE_API_URL=
VITE_SHARE_BASE_URL=http://localhost:3000

# Build-time env for Next.js frontend
NEXT_PUBLIC_API_URL=https://your-api-domain.com
NEXT_PUBLIC_SITE_URL=https://stplatwebd70cb7be.z13.web.core.windows.net


# Upload limits (set to -1 for unlimited; default 10 for production)
DOCUMENT_UPLOAD_LIMIT=10
