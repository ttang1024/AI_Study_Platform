# Database
POSTGRES_DB=studyplatform
POSTGRES_USER=studyplatform
POSTGRES_PASSWORD=your_secure_password

# JWT
JWT_SECRET_KEY=your_64_char_hex_secret_key
JWT_ISSUER=Study Platform
JWT_AUDIENCE=Study Platform Users
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Email (Gmail SMTP)
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=Study Platform
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents

# AI / External APIs
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_SUBTITLE_LANGUAGES=en.*,en
# Optional. deploy scripts also auto-read ./cookies.txt when present.
YOUTUBE_COOKIES_BASE64=

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend origins for CORS
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:4200

# Build-time env for Vite frontends (leave empty to use nginx proxy)
VITE_API_URL=
VITE_SHARE_BASE_URL=http://localhost:3000

# Build-time env for Next.js frontend
NEXT_PUBLIC_API_URL=https://your-api-domain.com
NEXT_PUBLIC_SITE_URL=https://stplatwebd70cb7be.z13.web.core.windows.net

# Azure Application Insights (optional)
APPINSIGHTS_CONNECTION_STRING=

# Upload limits (set to -1 for unlimited; default 10 for production)
DOCUMENT_UPLOAD_LIMIT=10
