# Database
#
# Production runs against a managed Postgres (Supabase). Set the full connection string here and it
# is used by both docker compose and ./deploy.sh — placeholders only, never a real credential in a
# committed file. Get it from Supabase → Project Settings → Database → Connection string → .NET, and
# prefer the *session* pooler (port 5432 on aws-*.pooler.supabase.com): a long-lived ECS task keeps
# its own Npgsql pool, and the pooler's IPv4 endpoint is reachable from an ordinary VPC.
DATABASE_CONNECTION_STRING=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require
# Apply EF Core migrations at API startup. Set false and run `dotnet ef database update` yourself
# once more than one replica starts at a time.
DATABASE_MIGRATE_ON_STARTUP=true

# Only used by the bundled docker compose postgres. Ignored when DATABASE_CONNECTION_STRING is set.
POSTGRES_DB=studyplatform
POSTGRES_USER=studyplatform
POSTGRES_PASSWORD=your_secure_password

# Cache (optional)
#
# Redis is off by default and nothing requires it: the distributed cache falls through to the
# Postgres CacheEntries table and SignalR uses its in-memory lifetime manager. Turn it on only with a
# real Redis to point at — `docker compose up -d redis` locally, or your own managed instance.
REDIS_ENABLED=false
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=StudyPlatform:

# JWT
JWT_SECRET_KEY=your_64_char_hex_secret_key
JWT_ISSUER=Study Platform
JWT_AUDIENCE=Study Platform Users
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Email (Gmail SMTP)
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=Study Platform
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Local object storage (MinIO, S3-compatible)
AWS_REGION=us-east-1
S3_BUCKET_NAME=documents-dev
S3_SERVICE_URL=http://minio:9000
S3_PUBLIC_SERVICE_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# AI / External APIs
# Semantic search indexing. Optional — without it the embedding backfill worker no-ops and search
# falls back to keyword results.
EMBEDDINGS_PROVIDER=gemini
# text-embedding-004 was retired: the API answers NotFound for it. gemini-embedding-001
# emits 3072 dimensions by default, and the service asks for 1536 to match the vector column.
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_API_KEY=
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_SUBTITLE_LANGUAGES=en.*,en
# Optional. Use generate-cookies-env.sh for multiple deployed cookie sets.
YOUTUBE_COOKIES_B64=

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Frontend origins for CORS
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:4200

# Build-time env for Vite frontends (leave empty to use nginx proxy)
VITE_API_URL=
VITE_SHARE_BASE_URL=http://localhost:3000

# Build-time env for Next.js frontend
NEXT_PUBLIC_API_URL=https://your-api-domain.com
NEXT_PUBLIC_SITE_URL=https://your-api-domain.com

# Upload limits (set to -1 for unlimited; deploy defaults to 10 for production)
DOCUMENT_UPLOAD_LIMIT=10
AUDIO_UPLOAD_LIMIT=10
VIDEO_UPLOAD_LIMIT=10
